# Copie ce fichier en ".env" (cp .env.example .env) puis adapte les valeurs.
# Ne commit JAMAIS le vrai fichier .env.

# Génère une clé avec :
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me

# True en développement, False en production
DEBUG=True

# Hôtes autorisés, séparés par des virgules
ALLOWED_HOSTS=127.0.0.1,localhost

# Origines des frontends autorisés à appeler l'API (CORS), séparées par des virgules
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
